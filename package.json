{
  "name": "@astra-camp/lens",
  "version": "0.1.0",
  "private": false,
  "description": "A modern, plugin-based WebGL rendering engine built with TypeScript and React.",
  "keywords": [
    "react",
    "webgl",
    "3d",
    "lens"
  ],
  "homepage": "https://github.com/astra-camp/lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra-camp/lens.git"
  },
  "bugs": {
    "url": "https://github.com/astra-camp/lens/issues"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=17 <21",
    "react-dom": ">=17 <21"
  },
  "dependencies": {
    "gl-matrix": "^3.4.3",
    "regl": "^2.1.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/experimental-addon-test": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@types/react": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/browser": "3.1.4",
    "@vitest/coverage-v8": "3.1.4",
    "eslint": "^9.27.0",
    "eslint-plugin-storybook": "^0.12.0",
    "playwright": "^1.52.0",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "size-limit": "^11.2.0",
    "storybook": "^8.6.14",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.1.4"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "vite build",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "size": "size-limit",
    "release": "semantic-release"
  },
  "size-limit": [
    {
      "path": "dist/index.esm.js",
      "limit": "40 KB"
    },
    {
      "path": "dist/index.umd.js",
      "limit": "60 KB"
    }
  ],
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "author": "smkhalsa",
  "license": "ISC"
}
